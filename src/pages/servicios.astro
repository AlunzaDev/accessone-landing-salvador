---
import InteriorLayout from '../layouts/InteriorLayout.astro';
const services = [
  { icon: '↔', title: 'Control de accesos y salidas', text: 'Sistemas para gestionar el ingreso y egreso de vehículos con tecnología de vanguardia, aprovechando mejor cada ubicación y manteniendo el control de las áreas de circulación.' },
  { icon: '◇', title: 'Mantenimiento', text: 'Programas preventivos y correctivos para mantener cada parqueo en condiciones óptimas.', items: ['Bordillos y señalización', 'Demarcación y pintura', 'Bacheo preventivo', 'Cambio de luminarias'] },
  { icon: '◎', title: 'Autolavado', text: 'Espacios para lavado profesional con personal capacitado y equipo de primer nivel: mayor comodidad para los visitantes y una nueva oportunidad de ingreso.' },
  { icon: 'P', title: 'Valet parking', text: 'Recepción y entrega ágil de vehículos con operadores capacitados, supervisión, control mediante inventarios e imagen profesional.', items: ['Personal con licencia y pruebas de manejo', 'Señalización y módulos identificados', 'Equipo de intercomunicación y apoyo vial'] },
  { icon: '+', title: 'Asistencia y emergencias', text: 'Apoyo discreto a los usuarios ante situaciones imprevistas dentro del parqueo.', items: ['Carga de baterías', 'Revisión de niveles básicos', 'Contacto con cerrajero 24 horas', 'Asistencia médica de emergencia'] },
  { icon: '▦', title: 'Taquillas y accesos', text: 'Control de acceso de personas para parques recreativos, cines, ferias y otras instalaciones mediante torniquetes inteligentes y validación de tickets.' },
  { icon: '✦', title: 'Limpieza', text: 'Personal calificado para mantener las instalaciones en condiciones óptimas de limpieza, funcionamiento y presentación durante la operación.' },
  { icon: '24', title: 'Horarios y tarifas flexibles', text: 'Operaciones adaptables a las necesidades de cada proyecto, incluso durante las 24 horas, todos los días del año.', items: ['Cobro por hora o fracción', 'Tarifa única', 'Pensión diaria o mensual', 'Esquemas personalizados'] },
];
---
<InteriorLayout title="Servicios | AccessOne El Salvador" description="Servicios integrales para diseñar, operar y mantener parqueos en El Salvador.">
  <section class="page-hero"><p class="tag">Servicios</p><h1>Una operación. Todos los frentes.</h1><p>Soluciones conectadas para diseñar, equipar, operar y mantener parqueos en El Salvador.</p></section>
  <section class="services-intro"><p class="tag">Experiencia integral</p><h2>Todo lo que un parqueo necesita para operar mejor.</h2><p>Integramos infraestructura, tecnología y atención para crear soluciones confiables, adaptables y centradas en la experiencia de cada usuario.</p></section>
  <section class="solutions services-catalog"><div class="cards services-grid">{services.map((service,i) => <article><span>{String(i+1).padStart(2,'0')}</span><div class="icon">{service.icon}</div><h3>{service.title}</h3><p>{service.text}</p>{service.items && <ul>{service.items.map((item) => <li>{item}</li>)}</ul>}<b>AccessOne <i>↗</i></b></article>)}</div></section>
  <section class="service-proof"><p class="tag">Trayectoria construida en México</p><strong>+30,000</strong><h2>espacios de parqueo</h2><p>Experiencia desarrollada en México en parqueos, hospitales, clubes deportivos, exposiciones y centros comerciales; conocimiento que ahora ponemos al servicio de proyectos en El Salvador.</p><a href="/contacto">Contanos sobre tu proyecto <b>↗</b></a></section>
</InteriorLayout>
