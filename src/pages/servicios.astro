---
import InteriorLayout from '../layouts/InteriorLayout.astro';
import {
  CountUp,
  ServiceCatalog,
  type IconName,
} from '@alunzadev/accessone-ui';
import '@alunzadev/accessone-ui/styles/service-catalog.css';
const services: { icon: IconName; title: string; text: string; items?: string[] }[] = [
  { icon: 'access', title: 'Control de accesos y salidas', text: 'Sistemas para gestionar el ingreso y egreso de vehículos con tecnología de vanguardia, aprovechando mejor cada ubicación y manteniendo el control de las áreas de circulación.' },
  { icon: 'maintenance', title: 'Mantenimiento', text: 'Programas preventivos y correctivos para mantener cada parqueo en condiciones óptimas.', items: ['Bordillos y señalización', 'Demarcación y pintura', 'Bacheo preventivo', 'Cambio de luminarias'] },
  { icon: 'wash', title: 'Autolavado', text: 'Espacios para lavado profesional con personal capacitado y equipo de primer nivel: mayor comodidad para los visitantes y una nueva oportunidad de ingreso.' },
  { icon: 'valet', title: 'Valet parking', text: 'Recepción y entrega ágil de vehículos con operadores capacitados, supervisión, control mediante inventarios e imagen profesional.', items: ['Personal con licencia y pruebas de manejo', 'Señalización y módulos identificados', 'Equipo de intercomunicación y apoyo vial'] },
  { icon: 'support', title: 'Asistencia y emergencias', text: 'Apoyo discreto a los usuarios ante situaciones imprevistas dentro del parqueo.', items: ['Carga de baterías', 'Revisión de niveles básicos', 'Contacto con cerrajero 24 horas', 'Asistencia médica de emergencia'] },
  { icon: 'ticket', title: 'Taquillas y accesos', text: 'Control de acceso de personas para parques recreativos, cines, ferias y otras instalaciones mediante torniquetes inteligentes y validación de tickets.' },
  { icon: 'clean', title: 'Limpieza', text: 'Personal calificado para mantener las instalaciones en condiciones óptimas de limpieza, funcionamiento y presentación durante la operación.' },
  { icon: 'clock', title: 'Horarios y tarifas flexibles', text: 'Operaciones adaptables a las necesidades de cada proyecto, incluso durante las 24 horas, todos los días del año.', items: ['Cobro por hora o fracción', 'Tarifa única', 'Pensión diaria o mensual', 'Esquemas personalizados'] },
];
---
<InteriorLayout title="Servicios | AccessOne Centroamérica" description="Servicios integrales para diseñar, operar y mantener parqueos en Centroamérica.">
  <section class="page-hero"><p class="tag">Servicios</p><h1>Una operación. Todos los frentes.</h1><p>Soluciones conectadas para diseñar, equipar, operar y mantener parqueos en Centroamérica.</p></section>
  <section class="services-intro"><p class="tag">Experiencia integral</p><h2>Todo lo que un parqueo necesita para operar mejor.</h2><p>Integramos infraestructura, tecnología y atención para crear soluciones confiables, adaptables y centradas en la experiencia de cada usuario.</p></section>
  <section class="solutions services-catalog"><ServiceCatalog client:load ctaLabel="Contanos sobre tu proyecto" services={services.map(({ text, ...service }) => ({ ...service, description: text }))} /></section>
  <section class="service-proof"><p class="tag">Trayectoria construida en México</p><strong><CountUp client:load value={30000} prefix="+" /></strong><h2>espacios de parqueo</h2><p>Experiencia desarrollada en México en parqueos, hospitales, clubes deportivos, exposiciones y centros comerciales; conocimiento que ahora ponemos al servicio de proyectos en Centroamérica.</p><a href="/contacto">Contanos sobre tu proyecto <b>↗</b></a></section>
</InteriorLayout>
