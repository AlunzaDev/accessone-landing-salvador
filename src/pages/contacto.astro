---
import InteriorLayout from '../layouts/InteriorLayout.astro';
import ContactForm from '../components/ContactForm';
import Icon from '../components/Icon';
---
<InteriorLayout title="Contacto | AccessOne El Salvador" description="Hablemos sobre la operación, tecnología y mantenimiento de tu parqueo en El Salvador.">
  <section class="page-hero contact-hero"><p class="tag">Contacto</p><h1>Tu siguiente proyecto empieza aquí.</h1><p>Contanos cómo podemos mejorar la operación y experiencia de tu parqueo en El Salvador.</p></section>
  <section class="contact-directory" aria-labelledby="contact-directory-title">
    <div class="directory-heading">
      <div class="directory-heading-title">
        <p class="tag">AccessOne El Salvador</p>
        <h2 id="contact-directory-title">Estamos para apoyarte.</h2>
      </div>
      <div class="directory-heading-copy">
        <span aria-hidden="true"></span>
        <p>Comunicate con Imelda Morales Ochoa para conversar sobre tu proyecto en El Salvador.</p>
      </div>
    </div>
    <div class="directory-grid">
      <article><span aria-hidden="true"><Icon name="mail" className="contact-icon" /></span><p>Correo electrónico</p><a href="mailto:iochoa@accessone.com.sv">iochoa@accessone.com.sv</a><small>Imelda Morales Ochoa</small></article>
      <article><span aria-hidden="true"><Icon name="phone" className="contact-icon" /></span><p>Teléfono</p><a href="tel:+50378306923">+503 7830 6923</a><small>Imelda Morales Ochoa</small></article>
      <article><span aria-hidden="true"><Icon name="location" className="contact-icon" /></span><p>Ubicación</p><strong>San Salvador</strong><small>Dirección por confirmar</small></article>
      <article><span aria-hidden="true"><Icon name="clock" className="contact-icon" /></span><p>Horario de atención</p><strong>Lunes a viernes · 8:00 a 17:00</strong><small>Horario por confirmar</small></article>
    </div>
  </section>
  <section class="contact-form-section"><ContactForm client:load /></section>
</InteriorLayout>
